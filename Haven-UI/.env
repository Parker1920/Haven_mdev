## Haven UI environment sample file
# Copy this to .env and edit values.

# Admin password for web UI login (required for admin console actions).
HAVEN_ADMIN_PASSWORD=Haven

# Optional admin token for header-based admin access (legacy method).
HAVEN_ADMIN_TOKEN=

# API key for the Discord bot to post discoveries. The bot should send X-API-Key header.
HAVEN_API_KEY=change-me

# Path override for the UI's data, logs, and dist folders. If not set, defaults to repo.
# HAVEN_UI_DIR=/path/to/Haven-UI

# ==================== ROUND TABLE AI ====================
# Claude AI (Anthropic) - Primary AI provider
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=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

# OpenAI GPT - Optional fallback provider
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: Configure which AI model to use
RTAI_PRIMARY_MODEL=claude
RTAI_FALLBACK_MODEL=gpt
